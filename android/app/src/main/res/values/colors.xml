<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Accent for the notification small icon and the notification dot on API 33+
      launchers. This is the Foam Shop brand blue (AppColors.primary in
      lib/theme/app_theme.dart is 0xFF182346, the brand solid is 0xFF3D5387).
      Declared as a color resource rather than hard-coded in Dart so the Android
      side has the same value without a platform-channel round trip.
    -->
    <color name="notification_accent">#FF3D5387</color>

    <!--
      Colorizes the app's status-bar entry. Kept at the brand solid so a posted
      notification reads as Foam Shop rather than as an unbranded system alert.
      Only affects the accent line/dot, never the small icon itself, which stays
      monochrome by Android requirement.
    -->
    <color name="notification_color">#FF3D5387</color>

</resources>
